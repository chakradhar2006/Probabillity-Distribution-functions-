
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats

sns.set_theme(style="whitegrid")
plt.figure(figsize=(12, 5))

# Binomial Distribution (Discrete)
n, p = 10, 0.5
x_binom = np.arange(0, n + 1)
y_binom = stats.binom.pmf(x_binom, n, p)

plt.subplot(1, 2, 1)
plt.bar(x_binom, y_binom, color='skyblue', edgecolor='black')
plt.title('Discrete: Binomial Distribution (n=10, p=0.5)')
plt.xlabel('Number of Successes')
plt.ylabel('Probability')

# Normal Distribution (Continuous)
mu, sigma = 0, 1
x_norm = np.linspace(-4, 4, 1000)
y_norm = stats.norm.pdf(x_norm, mu, sigma)

plt.subplot(1, 2, 2)
plt.plot(x_norm, y_norm, color='red', linewidth=2)
plt.fill_between(x_norm, y_norm, alpha=0.3, color='red')
plt.title('Continuous: Normal Distribution (μ=0, σ=1)')
plt.xlabel('Value')
plt.ylabel('Probability Density')

plt.tight_layout()
plt.show()
